      <!-- ─── FAQ ─── -->
      <section id="faq" class="py-[88px] bg-surface-alt">
        <div class="mx-auto max-w-6xl px-4">
          <div class="max-w-[720px] mx-auto mb-[52px] text-center">
            <h2 class="font-serif tracking-[-0.03em] leading-[1.1] text-[clamp(1.7rem,3.2vw,2.35rem)] font-semibold mb-3 text-balance"
                style="font-family: 'Newsreader', 'Instrument Serif', Georgia, serif; letter-spacing: -0.02em;">
              Pertanyaan Umum
            </h2>
            <p class="text-[17px] text-muted">Jawaban untuk pertanyaan yang sering diajukan sebelum memulai proyek Agentic AI.</p>
          </div>

          <div class="max-w-[800px] mx-auto grid gap-0">
            <!-- FAQ Item 1 -->
            <div class="faq-item border-b border-divider">
              <button class="faq-question w-full flex justify-between items-center py-[18px] bg-none border-none text-primary text-[17px] font-semibold text-left cursor-pointer"
                      aria-expanded="false" onclick="this.parentElement.classList.toggle('open'); this.setAttribute('aria-expanded', this.parentElement.classList.contains('open'));">
                <span>Apa itu Agentic AI?</span>
                <svg class="faq-icon w-[14px] h-[14px] transition-transform duration-200 text-primary" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 5.5L7 9.5L11 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="faq-answer pb-[18px] text-muted text-[15px] leading-[1.7]">
                Agentic AI adalah sistem AI yang mampu merencanakan, membuat keputusan, dan mengeksekusi tugas secara otonom menggunakan tool calling, memory, dan multi-step reasoning — bukan sekadar chatbot yang menunggu instruksi.
              </div>
            </div>

            <!-- FAQ Item 2 -->
            <div class="faq-item border-b border-divider">
