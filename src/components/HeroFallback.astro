---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle = 'superkilat.com' } = Astro.props;

// Wrap title into lines (max ~26 chars per line, max 4 lines)
const words = title.split(' ');
const lines: string[] = [];
let current = '';
for (const word of words) {
	const candidate = current ? `${current} ${word}` : word;
	if (candidate.length > 26 && current) {
		lines.push(current);
		current = word;
	} else {
		current = candidate;
	}
	if (lines.length === 3) break; // keep last line for the rest
}
if (current && lines.length < 4) lines.push(current);
// If truncated, append ellipsis to last line
const joined = lines.join(' ');
if (joined.length < title.length) {
	lines[lines.length - 1] = lines[lines.length - 1] + '…';
}

const fontSize = lines.length > 2 ? 52 : 64;
const lineHeight = fontSize * 1.18;
const textBlockHeight = lines.length * lineHeight;
const startY = 315 - textBlockHeight / 2 + fontSize * 0.8;
---

<svg
	class="w-full rounded-[10px]"
	style="border: 1px solid var(--color-divider);"
	viewBox="0 0 1200 630"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label={title}
>
	<!-- Black background -->
	<rect width="1200" height="630" fill="#0a0a0a" />

	<!-- Yellow accent shapes -->
	<rect x="0" y="0" width="1200" height="8" fill="#facc15" />
	<rect x="0" y="622" width="1200" height="8" fill="#facc15" />
	<circle cx="1080" cy="120" r="140" fill="none" stroke="#facc15" stroke-width="2" opacity="0.35" />
	<circle cx="1080" cy="120" r="90" fill="none" stroke="#facc15" stroke-width="2" opacity="0.2" />
	<circle cx="120" cy="520" r="110" fill="none" stroke="#facc15" stroke-width="2" opacity="0.25" />
	<rect x="60" y="60" width="14" height="14" fill="#facc15" />
	<rect x="1126" y="556" width="14" height="14" fill="#facc15" />

	<!-- Subtle grid -->
	<g stroke="#facc15" stroke-width="1" opacity="0.06">
		<line x1="300" y1="0" x2="300" y2="630" />
		<line x1="600" y1="0" x2="600" y2="630" />
		<line x1="900" y1="0" x2="900" y2="630" />
		<line x1="0" y1="210" x2="1200" y2="210" />
		<line x1="0" y1="420" x2="1200" y2="420" />
	</g>

	<!-- Title -->
	<text
		x="600"
		text-anchor="middle"
		font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
		font-weight="700"
		font-size={fontSize}
		fill="#ffffff"
	>
		{lines.map((line, i) => (
			<tspan x="600" y={startY + i * lineHeight}>{line}</tspan>
		))}
	</text>

	<!-- Brand -->
	<text
		x="600"
		y="580"
		text-anchor="middle"
		font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
		font-size="22"
		letter-spacing="4"
		fill="#facc15"
	>
		{subtitle.toUpperCase()}
	</text>
</svg>
