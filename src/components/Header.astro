---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-50 border-b border-divider" style="background: rgba(255,255,255,0.85); backdrop-filter: blur(18px) saturate(1.2);">
  <nav class="mx-auto max-w-6xl px-4 h-[66px] flex items-center justify-between" aria-label="Main navigation">
    <!-- Logo / Site title -->
    <a
      href="/"
      class="flex items-center gap-2 no-underline group"
      aria-label={SITE_TITLE + ' — Home'}
    >
      <div class="w-[34px] h-[34px] rounded-[8px] bg-primary text-white flex items-center justify-center font-bold text-[15px]" aria-hidden="true">
        {SITE_TITLE.slice(0,1)}
      </div>
      <span class="text-[15px] font-semibold tracking-tight text-primary font-sans group-hover:text-secondary transition-colors duration-200">
        {SITE_TITLE}
      </span>
    </a>

    <!-- Nav links -->
    <div class="flex items-center gap-1" role="list">
      <HeaderLink href="/" class="px-3 py-1.5 text-[13px] font-medium font-mono">Home</HeaderLink>
      <HeaderLink href="/blog" class="px-3 py-1.5 text-[13px] font-medium font-mono">Blog</HeaderLink>
      <HeaderLink href="/about" class="px-3 py-1.5 text-[13px] font-medium font-mono">About</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header a {
    text-decoration: none;
  }
</style>
